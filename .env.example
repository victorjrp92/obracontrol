# ─────────────────────────────────────────────────────────────────────────────
# Seiricon (obracontrol) — variables de entorno
#
# EN LOCAL:      copia este archivo a `.env.local` y rellena los valores.
#                `.env.local` nunca se comitea (`.gitignore` ignora `.env*`;
#                este ejemplo está exceptuado a propósito).
# EN PRODUCCIÓN: las mismas variables van en Vercel
#                (Project → Settings → Environment Variables), no en un archivo.
# EN CI:         solo `CRON_SECRET` y `DIRECT_URL`, como GitHub Secrets
#                (Settings → Secrets and variables → Actions).
#
# Cómo leer las marcas:
#   [obligatoria] sin ella la app no arranca o el módulo se cae
#   [opcional]    si falta, esa función se apaga sola y el resto sigue andando
#   NEXT_PUBLIC_  viaja al navegador: NUNCA pongas un secreto con ese prefijo
# ─────────────────────────────────────────────────────────────────────────────


# ─── Base de datos (Supabase Postgres) ───────────────────────────────────────
# DATABASE_URL usa el pooler (puerto 6543) y DIRECT_URL la conexión directa
# (5432), que es la que necesitan las migraciones de Prisma.
# [obligatorias]
DATABASE_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres"


# ─── Supabase (autenticación y storage) ──────────────────────────────────────
# La llave pública es la que el código lee como ..._PUBLISHABLE_DEFAULT_KEY.
# SERVICE_ROLE se salta toda regla de RLS: solo servidor, jamás NEXT_PUBLIC_.
# [obligatorias]
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ─── Sitio ───────────────────────────────────────────────────────────────────
# Base con la que se arma la URL de retorno del pago y los enlaces de los
# correos. En local: http://localhost:3000. Si falta, el checkout asume
# https://seiricon.com — y el cliente volvería de Wompi a producción.
# [obligatoria en producción]
NEXT_PUBLIC_SITE_URL="https://seiricon.com"


# ═════════════════════════════════════════════════════════════════════════════
#  PASARELA DE PAGOS — Wompi
#
#  Dónde salen: panel de comercios (https://comercios.wompi.co) → Mi cuenta →
#  "Llaves / Secretos para integración técnica". Hay dos juegos completos, uno
#  de Sandbox y uno de Producción: NO se mezclan.
#
#      Sandbox     pub_test_…    prv_test_…    test_integrity_…    test_events_…
#      Producción  pub_prod_…    prv_prod_…    prod_integrity_…    prod_events_…
#
#  Las cuatro tienen que estar. Si falta una, `wompiConfigurado()` da false: el
#  botón de pagar no se muestra y /api/pagos/checkout responde 503. Es a
#  propósito — media configuración cobraría mal.
#
#  Además hay que registrar la URL de eventos en el panel de Wompi (una para
#  Sandbox y otra para Producción, en la misma sección):
#      https://TU-DOMINIO/api/pagos/wompi/webhook
#
#  Guía completa de activación: docs/pasarela-de-pagos.md
# ═════════════════════════════════════════════════════════════════════════════

# Llave pública. Viaja al navegador (va en la URL del checkout): no es secreta.
# [obligatoria para cobrar]
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_TU_LLAVE_AQUI"

# Llave privada. Autentica las consultas a la API de Wompi (el webhook la usa
# para confirmar cada transacción contra Wompi antes de dar acceso). SECRETA.
# [obligatoria para cobrar]
WOMPI_PRIVATE_KEY="prv_test_TU_LLAVE_AQUI"

# Secreto de integridad. Firma el monto del checkout para que nadie lo cambie
# desde el navegador. SECRETO.
# [obligatoria para cobrar]
WOMPI_INTEGRITY_SECRET="test_integrity_TU_SECRETO_AQUI"

# Secreto de eventos. Valida la firma de los webhooks. Sin él, cualquiera
# podría declarar aprobado un pago que nunca ocurrió. SECRETO.
# [obligatoria para cobrar]
WOMPI_EVENTS_SECRET="test_events_TU_SECRETO_AQUI"

# "produccion" → API https://production.wompi.co/v1 (dinero real)
# cualquier otro valor (o ausente) → https://sandbox.wompi.co/v1 (pruebas)
# Tiene que ir de la mano con el juego de llaves: llaves prod ⇢ "produccion".
WOMPI_AMBIENTE="pruebas"

# ─── Precios de prueba (para verificar el cobro real sin gastar) ─────────────
# Con "true", los planes se cobran a montos simbólicos: OBRA $1.000,
# PROYECTO $2.000, EMPRESA $3.000, y ningún cobro pasa de $5.000. El cobro es
# REAL (dinero de verdad, PSE de verdad); lo único simbólico es el monto.
# Los precios de `src/lib/suscripcion.ts` NO se tocan: se sustituyen al vuelo.
#
# ⚠️ ACOTA SIEMPRE con PRECIOS_PRUEBA_CORREOS. Con la lista vacía, CUALQUIER
# cliente puede comprar el plan Empresa por mil pesos. Con la lista puesta, solo
# esas cuentas ven precios de prueba y el resto paga el precio real.
# Apágalo en cuanto termines la prueba.
PRECIOS_PRUEBA="false"
PRECIOS_PRUEBA_CORREOS=""


# ─── Correo (Resend) ─────────────────────────────────────────────────────────
# Los correos salen de notificaciones@seiricon.com: ese dominio tiene que estar
# verificado en Resend. Sin esta llave no salen invitaciones, códigos de borrado
# de proyecto ni avisos de vencimiento.
# [obligatoria en producción]
RESEND_API_KEY=""


# ─── Tareas programadas ──────────────────────────────────────────────────────
# Protege /api/cron/avisos-vencimiento (Authorization: Bearer <secreto>). Sin
# secreto la ruta responde 503 en vez de quedar abierta. El mismo valor va como
# GitHub Secret CRON_SECRET, que es lo que usa .github/workflows/avisos.yml.
# Genera uno con:  openssl rand -hex 32
# [obligatoria en producción]
CRON_SECRET=""


# ─── IA ──────────────────────────────────────────────────────────────────────
# DeepSeek: sugerencias de tareas (/api/sugerencias/*). Si falta, se usan las
# plantillas deterministas.
# [opcional]
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=""

# Visión de Seiricon Alerta (lectura de grietas). Apagada salvo que
# ALERTA_VISION_ENABLED sea exactamente "true" Y esté la llave del proveedor.
# [opcional]
ALERTA_VISION_ENABLED="false"
ALERTA_VISION_PROVEEDOR="anthropic"   # "anthropic" (por defecto) | "gemini"
ALERTA_VISION_MODEL=""                # vacío = el modelo por defecto del proveedor
ANTHROPIC_API_KEY=""                  # si el proveedor es anthropic
GEMINI_API_KEY=""                     # si el proveedor es gemini


# ─── Mapas y analítica ───────────────────────────────────────────────────────
# Sin token de Mapbox el selector de ubicación y el mapa de proyectos no cargan.
# [opcional]
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_CLARITY_ID=""


# ─── Banderas de operación ───────────────────────────────────────────────────
# "true" pausa el flujo público de Go Juntos (/go/juntos).
JUNTOS_PAUSADO="false"
# Cuántos PDF se generan a la vez. Por defecto 2.
PDF_MAX_CONCURRENTES="2"
