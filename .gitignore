# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# PWA (generated by Serwist)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/workbox-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la plantilla sin secretos: es la lista de lo que hay que
# configurar, y no sirve de nada si no viaja con el repo.
!.env.example

# vercel
.vercel

# claude code local config (skills, worktrees, agent state)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# playwright screenshots and cache
.playwright-cli/
landing-*.png
hero-*.png
*-mobile.png

# artefactos de generación de documentos de ventas (docx/pptx)
docs/ventas/build/

# unlazy: estado local del hook y aprobaciones de oráculos (rutas absolutas de
# la máquina). El ledger (.unlazy/<scope>/) SÍ se versiona: es la evidencia.
.unlazy-hook-state.json
.claude/settings.local.json

# Capturas sueltas en la raíz: se generan al verificar pantallas y no son
# parte del producto. Las que SÍ se usan (el deck de ventas) viven en
# docs/ventas/assets/ junto al script que las consume.
/*.png
/*.jpg
/*.jpeg
