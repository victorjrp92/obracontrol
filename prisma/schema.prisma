  constructora_id                String
  fase                           String
  subfase                        String?
  espacio                        String
  nombre                         String
  tiempo_acordado_dias           Int
  precio                         Float?
  marca_linea                    String?
  componentes                    String?
  proyectos_sin_uso_consecutivos Int      @default(0)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  constructora Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)

  @@unique([constructora_id, fase, espacio, nombre])
  @@map("tareas_aprendidas")
}

// ─── REGISTRO DE PRECIOS (flywheel, sin IA) ──────────────────────────────────
// Cada vez que una obra fija/edita un precio de tarea, dejamos un rastro aquí.
// La capa de sugerencias (precios-mercado.ts) lee de aquí una mediana/promedio
// ponderado por `peso` (confianza por fuente). NO se conecta a la UI todavía.
// `proyecto_id`/`constructora_id` quedan como campos sueltos (sin relación) a
// propósito: simplifica la captura pasiva y el borrado no debe cascar nada.
model RegistroPrecio {
  id                String   @id @default(cuid())
  tarea_normalizada String   // misma normalización que buscarPrecioSemilla
  ciudad            String?
  tipo_obra         String?
  precio            Int      // COP, por la unidad de la tarea
  fuente            String   // "semilla" | "sugerido" | "editado" | "factura" | "pago_confirmado"
  peso              Float    @default(1) // confianza: pago_confirmado>factura>editado>sugerido>semilla
  constructora_id   String?  // para poder filtrar/aislar; null = global
  proyecto_id       String?
  created_at        DateTime @default(now())

  @@index([tarea_normalizada, ciudad])
  @@map("registros_precio")
}

// ─── REGISTRO DE DURACIONES (flywheel, sin IA) ───────────────────────────────
// Espejo de RegistroPrecio para DURACIONES: cuando una tarea pasa a APROBADA y
// tiene `fecha_inicio` + fecha real de fin, dejamos el rastro de días reales
// vs. estimados. La capa de lectura (duraciones-mercado.ts) devuelve la mediana
// de días reales por tarea normalizada (+ ciudad). NO conectado a la UI aún:
// el motor determinista (estimar-duracion.ts) es la fuente por ahora.
// Sin foreign keys a propósito (mismo criterio que RegistroPrecio: la captura
// pasiva jamás debe romper la aprobación, ni el borrado de una obra cascar).
model RegistroDuracion {
  id                String   @id @default(cuid())
  tarea_normalizada String   // misma normalización que normalizarTarea()
  fase              String   // fase curada (faseDeTarea) o, si no matchea, la fase de la obra
  ciudad            String?
  metraje           Float?   // m² del espacio de la tarea, si existía
  dias_estimados    Float    // tiempo_acordado_dias vigente al aprobar (= el PLAN del usuario)
  dias_reales       Float    // fecha_inicio → fecha_fin_real (días calendario, mín 0.5)
  /// Lo que predijo `estimarDuracion` al crear el proyecto. `dias_estimados` NO
  /// sirve para evaluar el motor: `repartirGlobal()` lo sobrescribe con el
  /// reparto del plazo que puso el usuario, así que mide al usuario, no al
  /// algoritmo. Sin esta columna no se puede calcular el error del motor.
  dias_motor        Float?
  /// Días HÁBILES según el calendario del proyecto. `dias_reales` es calendario
  /// y mezclarlos produce un error del 20–33%.
  dias_reales_habiles Float?
  /// Sin cantidad, un registro de pintura de 12 m² y otro de 120 m² no son
  /// comparables y su mediana no significa nada.
  cantidad          Float?
  unidad            String?  // "m2" | "ml" | "un"
  cuadrillas        Int?
  proyecto_id       String?
  constructora_id   String?
  created_at        DateTime @default(now())

  @@index([tarea_normalizada, ciudad])
  @@map("registros_duracion")
}

// ─── LISTA DE ESPERA GO (landing B2C) ────────────────────────────────────────
// Correos captados por el CTA "Reserva tu cupo" de la landing Seiricon Go
// (/go-nueva). Captura pública pre-registro: sin relación con Constructora ni
// Usuario a propósito. `correo` UNIQUE + upsert en el API = sin duplicados y
// sin revelar si un correo ya estaba en la lista.

model ListaEsperaGo {
  id         String   @id @default(cuid())
  correo     String   @unique
  audiencia  String // "propietario" | "contratista"
  respuesta  String // pregunta segmentadora: ciudad/país (propietario) u obras al tiempo (contratista)
  origen     String? // CTA desde el que se abrió el modal (nav, hero, contratista, precio, cierre)
  created_at DateTime @default(now())

  @@map("lista_espera_go")
}


// ─── CONTACTO JUNTOS (línea de ayuda post-sismo, /go/juntos) ─────────────────
// Contactos del gate de datos del acta de documentación de daños. Captura
// pública sin auth ni tenant, como ListaEsperaGo. REGLA DURA (spec
// docs/specs/spec-go-juntos.md): la CÉDULA y la DIRECCIÓN del inmueble NUNCA
// se guardan aquí ni en ninguna otra tabla — viajan solo en el request de
// generación del PDF, se imprimen en el documento y se descartan.

enum TipoDocumentoJuntos {
  ACTA // acta de documentación de daños
  INFORME // informe de revisión de grietas
  PETICION // derecho de petición
}

/**
 * Registro de verificación de los documentos de «Juntos».
 *
 * POR QUÉ EXISTE: cada PDF imprime en el pie «Verificación: <folio> · <hash>».
 * Hasta ahora ese sello era decorativo — el folio y el hash se calculaban al
 * generar el documento y no se guardaban en ninguna parte, así que si una
 * aseguradora llamaba a preguntar «¿este acta es suya?», no había contra qué
 * cotejarlo. El producto prometía una verificación que no podía cumplir.
 *
 * QUÉ SE GUARDA Y QUÉ NO. Esta tabla contiene únicamente datos que NO
 * identifican a nadie: el folio, la huella del contenido, el tipo de documento,
 * la ciudad y el nivel del semáforo. Con eso se puede confirmar que un documento
 * salió de aquí, y de paso saber cómo se está repartiendo el daño por ciudad —
 * que es justo lo que una alcaldía necesita para el censo del RUD.
 *
 * NO se guarda, y no debe guardarse nunca: nombre, cédula, dirección, teléfono
 * ni las fotos. La cédula y la dirección tienen una promesa explícita en
 * pantalla; las fotos son el interior de la casa de alguien. Guardar fotos
 * exigiría un consentimiento aparte, con finalidad y plazo — decisión de negocio
 * que no se toma en el esquema.
 *
 * El hash se guarda COMPLETO aunque en el PDF se imprima corto: así se puede
 * cotejar con cualquiera de los dos.
 */
model DocumentoJuntos {
  id     String              @id @default(cuid())
  folio  String              @unique
  /** SHA-256 completo del contenido validado + folio. */
  hash   String
  tipo   TipoDocumentoJuntos
  ciudad String?
  /** Peor nivel del semáforo del documento: "rojo" | "amarillo" | "verde". Solo informes. */
  nivel  String?
  /** Cuántas grietas o espacios trae. Para el agregado, sin identificar nada. */
  piezas Int?

  created_at DateTime @default(now())

  @@index([created_at])
  @@index([ciudad, nivel])
  @@map("documentos_juntos")
}

model ContactoJuntos {
  id              String   @id @default(cuid())
  nombre          String
  whatsapp        String
  ciudad          String
  audiencia       String // "propietario" | "administrador" | "contratista"
  acepta_contacto Boolean  @default(false) // casilla OPCIONAL de contacto para reparación
  origen          String? // desde qué flujo se capturó (p. ej. "documentar-gate")
  created_at      DateTime @default(now())

  @@map("contacto_juntos")
}

// ════════════════════════════════════════════════════════════════════════════
// PRODUCTOS TÉCNICOS — Arquitecto y Constructora
// ════════════════════════════════════════════════════════════════════════════

enum TipoProductoTecnico {
  /// Foto del estado previo, tomada SIEMPRE desde la app con fecha, hora y GPS
  /// quemados. Una foto subida desde la galería no prueba fecha, y sin fecha el
  /// registro no sirve para la discusión que existe para ganar.
  REGISTRO_INICIAL
  PLANO
  RENDER
}

model ProductoTecnico {
  id          String              @id @default(cuid())
  proyecto_id String
  /// Un plano puede ser de toda la obra, de un piso o de una unidad concreta.
  /// Siempre pertenece a una obra; los otros dos niveles son opcionales.
  piso_id     String?
  unidad_id   String?
  tipo        TipoProductoTecnico
  nombre      String
  descripcion String?

  /// Ruta en el bucket de Supabase Storage. El archivo NO viaja por la base.
  storage_path String
  mime         String
  bytes        Int

  /// Versionado de planos: el desastre clásico de obra es alguien construyendo
  /// sobre un plano viejo, así que solo una versión puede estar vigente y las
  /// anteriores nunca se borran.
  version     Int      @default(1)
  vigente     Boolean  @default(true)
  reemplaza_a String?

  subido_por_id String
  created_at    DateTime @default(now())

  proyecto   Proyecto          @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  piso       Piso?             @relation(fields: [piso_id], references: [id], onDelete: SetNull)
  unidad     Unidad?           @relation(fields: [unidad_id], references: [id], onDelete: SetNull)
  subido_por Usuario           @relation(fields: [subido_por_id], references: [id], onDelete: Restrict)
  anterior   ProductoTecnico?  @relation("VersionProducto", fields: [reemplaza_a], references: [id], onDelete: SetNull)
  siguientes ProductoTecnico[] @relation("VersionProducto")

  @@index([proyecto_id, tipo])
  @@index([proyecto_id, vigente])
  @@map("productos_tecnicos")
}

// ════════════════════════════════════════════════════════════════════════════
// DOCUMENTOS FIRMABLES — infraestructura compartida
// ════════════════════════════════════════════════════════════════════════════
//
// Generaliza lo que hoy vive dentro de Juntos (`documentos_juntos`). El folio y
// la huella dejan de ser una pieza de esa línea para volverse un servicio: el
// acta de estado inicial del arquitecto usa exactamente el mismo mecanismo.
//
// Ley 527 de 1999 y Decreto 2364 de 2012: una firma electrónica simple es
// válida si se puede probar QUIÉN firmó, CUÁNDO, y que el documento NO cambió.
// La huella cubre lo tercero; `firmado_por_id` y `firmado_el` cubren los dos
// primeros. Por eso un documento firmado es inmutable: corregirlo emite una
// versión nueva con folio nuevo, y la anterior queda marcada como reemplazada.

/// Foto del LEVANTAMIENTO: el estado del inmueble ANTES de que exista obra.
///
/// No es una `Evidencia` y no debe serlo. `Evidencia` cuelga obligatoriamente
/// de una `Tarea` porque es la cadena que respalda las aprobaciones y, con
/// ellas, los pagos; aflojar ese `tarea_id` a opcional metería un caso nulo en
/// toda consulta que decide si una tarea se puede aprobar. Y son dos cosas
/// distintas: una evidencia prueba que algo se HIZO, un levantamiento documenta
/// cómo estaba ANTES. Sobreviven a cosas distintas, además: si se borra una
/// tarea su evidencia se va con ella; el levantamiento no.
///
/// `espacio_id` es opcional a propósito: en obra se disparan cuarenta fotos
/// seguidas y ponerse a elegir espacio en cada una mata el flujo. Se asocian
/// después, desde el escritorio, y ese id es lo que da el ANTES/DESPUÉS gratis
/// (levantamiento del espacio X contra evidencia final del espacio X).
model FotoLevantamiento {
  id          String  @id @default(cuid())
  proyecto_id String
  espacio_id  String?
  url_storage String
  /// Nota del arquitecto: "grieta en muro norte", "estado del piso".
  descripcion String?

  /// La marca la pone el DISPOSITIVO al capturar, no el servidor ni el usuario.
  /// Una foto subida desde la galería trae la fecha del archivo, que es
  /// falsificable, y entonces no sirve para documentar un estado inicial.
  gps_lat           Float?
  gps_lng           Float?
  timestamp_captura DateTime

  tomada_por String?
  created_at DateTime @default(now())

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  espacio  Espacio? @relation(fields: [espacio_id], references: [id], onDelete: SetNull)
  usuario  Usuario? @relation(fields: [tomada_por], references: [id])

  @@index([proyecto_id])
  @@index([espacio_id])
  @@map("fotos_levantamiento")
}

enum TipoDocumentoFirmable {
  /// Cotización formal de un preproyecto. Su FIRMA por parte del cliente es lo
  /// que cierra el trato: es el acto que convierte el preproyecto en obra. Se
  /// versiona en vez de editarse (`version` / `reemplaza_a`) porque una
  /// cotización firmada es contra la que después se compara el gasto real; si
  /// se pudiera editar, la varianza no significaría nada.
  COTIZACION
  ACTA_ESTADO_INICIAL
  INFORME_TECNICO
  ACTA_DANOS
  INFORME_GRIETAS
  DERECHO_PETICION
}

model DocumentoFirmable {
  id    String                @id @default(cuid())
  folio String                @unique
  /// SHA-256 del contenido validado + folio.
  hash  String
  tipo  TipoDocumentoFirmable

  /// Nulos en la línea Juntos, que no tiene tenant ni proyecto.
  proyecto_id     String?
  constructora_id String?

  /// Firma del profesional: la sesión autenticada ES la identidad.
  firmado_por_id String?
  firmado_el     DateTime?
  /// Matrícula profesional impresa en el documento, congelada al firmar: si el
  /// usuario la cambia después, el documento ya emitido no debe alterarse.
  matricula      String?

  /// «Recibido conforme» del cliente: constancia de ENTREGA, nunca aprobación
  /// del contenido. Esa distinción es la que evita que alguien firme conforme y
  /// después discuta el dictamen.
  recibido_por String?
  recibido_el  DateTime?

  /// Inmutabilidad: nunca se edita, se reemplaza.
  version     Int     @default(1)
  reemplaza_a String?

  /// Agregados sin identificar a nadie (los usa Juntos para el censo por ciudad).
  ciudad String?
  nivel  String?
  piezas Int?

  created_at DateTime @default(now())

  proyecto     Proyecto?           @relation(fields: [proyecto_id], references: [id], onDelete: SetNull)
  constructora Constructora?       @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  firmado_por  Usuario?            @relation(fields: [firmado_por_id], references: [id], onDelete: SetNull)
  anterior     DocumentoFirmable?  @relation("VersionDocumento", fields: [reemplaza_a], references: [id], onDelete: SetNull)
  siguientes   DocumentoFirmable[] @relation("VersionDocumento")

  @@index([created_at])
  @@index([ciudad, nivel])
  @@index([proyecto_id])
  @@map("documentos_firmables")
}
