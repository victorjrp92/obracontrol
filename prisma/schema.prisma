  subfase                        String?
  espacio                        String
  nombre                         String
  tiempo_acordado_dias           Int
  precio                         Float?
  marca_linea                    String?
  componentes                    String?
  proyectos_sin_uso_consecutivos Int      @default(0)
  created_at                     DateTime @default(now())
