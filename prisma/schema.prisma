generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── CONSTRUCTORA ────────────────────────────────────────────────────────────

model Constructora {
  id               String     @id @default(cuid())
  nombre           String
  nit              String?    @unique
  logo_url         String?
  direccion        String?
  ciudad           String?
  telefono         String?
  sitio_web        String?
  descripcion      String?
  plan_suscripcion PlanTipo   @default(OBRA)
  // Tipo de cuenta: gobierna qué módulos/menú ve y el tono del producto.
  // CONSTRUCTORA = comportamiento actual (empresa). CONTRATISTA y PROPIETARIO
  // son los perfiles "personales" (modo simple). Ver src/lib/plan.ts.
  tipo_cuenta      TipoCuenta @default(CONSTRUCTORA)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  usuarios           Usuario[]
  proyectos          Proyecto[]
  roles              Rol[]
  obreros            Obrero[]
  tareas_aprendidas  TareaAprendida[]
  clientes           Cliente[]
  perfil_onboarding  PerfilOnboarding?

  @@map("constructoras")
}

// ─── PERFIL ONBOARDING ───────────────────────────────────────────────────────
// Respuestas del cuestionario post-registro (Fase 2). Una fila por cuenta
// (la cuenta = constructora, incluidas las personales CONTRATISTA/PROPIETARIO).
// Todos los campos de perfil son opcionales: cada perfil llena solo los suyos.

model PerfilOnboarding {
  id               String   @id @default(cuid())
  constructora_id  String   @unique // 1 por cuenta (la cuenta = constructora, incl. personales)
  tipo_cuenta      String // CONSTRUCTORA | CONTRATISTA | PROPIETARIO
  // Contratista B2C
  oficio           String?
  tamano_equipo    String?
  control_actual   String[]  @default([]) // multi-select: WHATSAPP_FOTOS | EXCEL | CUADERNO | OTRA_APP | SIN_CONTROL
  control_otra     String?   // texto libre de "¿cuál?" cuando incluye OTRA_APP (≤80)
  // Propietario
  primera_obra      Boolean?
  tiene_contratista String?
  // Empresa
  obras_activas    String?
  tipo_obra        String?
  num_contratistas String?
  // Común
  departamento     String?
  ciudad           String?
  completado       Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  constructora     Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)

  @@map("perfil_onboarding")
}

// ─── CLIENTE (empresa externa) ──────────────────────────────────────────────

model Cliente {
  id               String       @id @default(cuid())
  constructora_id  String
  nombre           String
  nit              String?
  contacto         String?
  telefono         String?
  email            String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  constructora     Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  proyectos        Proyecto[]

  @@unique([constructora_id, nombre])
  @@map("clientes")
}

// ─── PROYECTO ────────────────────────────────────────────────────────────────

model Proyecto {
  id                      String         @id @default(cuid())
  constructora_id         String
  cliente_id              String?
  numero_registro         String?
  contratista_default_id  String?
  nombre                  String
  ubicacion_lat           Float?
  ubicacion_lng           Float?
  subtipo                 SubtipoProyecto
  dias_habiles_semana     Float          @default(5)
  checklists_habilitados  Boolean        @default(false)
  dependencias_habilitadas Boolean       @default(false)
  whatsapp_habilitado     Boolean        @default(false)
  fecha_inicio            DateTime?
  fecha_fin_estimada      DateTime?
  estado                  EstadoProyecto @default(ACTIVO)
  // Contexto B2C + índice de negocio (telemetría interna)
  tipo_obra               String?        // "REFORMA" | "MODIFICACION" | "OBRA_NUEVA"
  tipo_propiedad          String?        // "CASA" | "APARTAMENTO" | "EDIFICIO" | "LOCAL"
  punto_partida           String?        // "NUEVA" | "MEDIAS" | "AVANZADA" (estado de la obra)
  ciudad                  String?        // índice de precios por región
  presupuesto_total       Int?           // COP, opcional (modo "general" o sin presupuesto)
  presupuesto_mano_obra   Int?           // COP, opcional (modo "separado": bolsa de mano de obra)
  presupuesto_materiales  Int?           // COP, opcional (modo "separado": bolsa de materiales)
  metraje_total           Float?         // m² de toda la obra (alternativa a metraje por espacio)
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  constructora            Constructora   @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  cliente                 Cliente?       @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  cliente_acceso_tokens   ClienteAccesoToken[]
  edificios               Edificio[]
  fases                   Fase[]
  tipos_unidad            TipoUnidad[]
  checklist_templates     ChecklistTemplate[]
  pagos_contratista       PagoContratista[]
  tareas_sugeridas        TareaSugerida[]
  audit_logs              AuditLog[]
  admins_proyecto          AdminProyectoAccess[]
  contratista_default      Usuario?       @relation("ContratistaDefaultProyectos", fields: [contratista_default_id], references: [id], onDelete: SetNull)
  personas_externas        PersonaExternaProyecto[]
  reasignaciones           ReasignacionTarea[]
  gastos                   Gasto[]
  anticipos                Anticipo[]

  @@unique([constructora_id, numero_registro])
  @@index([contratista_default_id])
  @@index([cliente_id])
  @@map("proyectos")
}

// ─── ACCESO DEL CLIENTE (solo lectura del avance) — Fase 6 ───────────────────
// Token público por proyecto que el Contratista B2C comparte con su cliente
// para que VEA el avance de la obra (sin reportar, sin login). Read-only.
// `token` es aleatorio urlsafe (no cuid, para no filtrar orden de creación).
// Tenant-safe por construcción: el token apunta a un proyecto_id concreto.
// Máximo 1 token activo por proyecto (regenerar invalida el anterior).

model ClienteAccesoToken {
  id          String   @id @default(cuid())
  token       String   @unique // aleatorio, urlsafe
  proyecto_id String
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())

  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@index([proyecto_id])
  @@map("cliente_acceso_token")
}

// ─── EDIFICIO / TORRE ────────────────────────────────────────────────────────

model Edificio {
  id             String   @id @default(cuid())
  proyecto_id    String
  nombre         String
  num_pisos      Int
  es_zona_comun  Boolean  @default(false)
  created_at     DateTime @default(now())

  proyecto    Proyecto  @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  pisos       Piso[]

  @@map("edificios")
}

model Piso {
  id          String   @id @default(cuid())
  edificio_id String
  numero      Int
  created_at  DateTime @default(now())

  edificio    Edificio  @relation(fields: [edificio_id], references: [id], onDelete: Cascade)
  unidades    Unidad[]

  @@map("pisos")
}

model Unidad {
  id               String   @id @default(cuid())
  piso_id          String
  nombre           String
  tipo_unidad_id   String?
  metraje_total    Float?
  sentido               String?
  nombre_personalizado  String?
  created_at            DateTime @default(now())

  piso             Piso       @relation(fields: [piso_id], references: [id], onDelete: Cascade)
  tipo_unidad      TipoUnidad? @relation(fields: [tipo_unidad_id], references: [id])
  espacios         Espacio[]

  @@map("unidades")
}

model TipoUnidad {
  id          String   @id @default(cuid())
  proyecto_id String
  nombre      String
  created_at  DateTime @default(now())

  proyecto    Proyecto  @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  unidades    Unidad[]

  @@map("tipos_unidad")
}

model Espacio {
  id         String   @id @default(cuid())
  unidad_id  String
  nombre     String
  metraje    Float?
  created_at DateTime @default(now())

  unidad     Unidad   @relation(fields: [unidad_id], references: [id], onDelete: Cascade)
  tareas     Tarea[]
  gastos     Gasto[]

  @@map("espacios")
}

// ─── FASES Y TAREAS ──────────────────────────────────────────────────────────

model Fase {
  id                   String   @id @default(cuid())
  proyecto_id          String
  nombre               String
  orden                Int      @default(0)
  tiempo_estimado_dias Int?
  created_at           DateTime @default(now())

  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  tareas      Tarea[]

  @@map("fases")
}

model Tarea {
  id                        String       @id @default(cuid())
  espacio_id                String
  fase_id                   String
  numero_registro           String?      // {proyecto.numero_registro}-T{seq}
  nombre                    String
  subfase                   String?
  precio                    Float?
  codigo_referencia         String?
  nombre_pieza              String?
  marca_linea               String?
  componentes               String?
  cantidad_material_planeada Float?
  unidad_material           String?
  tiene_estructura          Boolean      @default(true)
  tiene_nave                Boolean      @default(true)
  tiene_chapa               Boolean      @default(false)
  tiene_cartera             Boolean      @default(false)
  tiempo_acordado_dias      Int
  fecha_inicio              DateTime?
  fecha_fin_real            DateTime?
  estado                    EstadoTarea  @default(PENDIENTE)
  asignado_a                String?
  depende_de                String?
  notas                     String?
  nota_reporte              String?
  foto_referencia_url       String?
  created_at                DateTime     @default(now())
  updated_at                DateTime     @updatedAt

  espacio                   Espacio      @relation(fields: [espacio_id], references: [id], onDelete: Cascade)
  fase                      Fase         @relation(fields: [fase_id], references: [id])
  asignado_usuario          Usuario?     @relation("TareasAsignadas", fields: [asignado_a], references: [id])
  tarea_dependencia         Tarea?       @relation("DependenciaTarea", fields: [depende_de], references: [id])
  tareas_dependientes       Tarea[]      @relation("DependenciaTarea")
  evidencias                Evidencia[]
  aprobaciones              Aprobacion[]
  checklist_respuesta       ChecklistRespuesta?
  retrasos                  Retraso[]
  extensiones_tiempo        ExtensionTiempo[]
  consumo_material          ConsumoMaterial?
  reasignaciones            ReasignacionTarea[]
  gastos                    Gasto[]

  @@index([asignado_a])
  @@index([estado])
  @@index([asignado_a, estado])
  @@map("tareas")
}

// ─── EVIDENCIA ───────────────────────────────────────────────────────────────

model Evidencia {
  id                String       @id @default(cuid())
  tarea_id          String
  tipo              TipoEvidencia
  url_storage       String
  gps_lat           Float?
  gps_lng           Float?
  timestamp_captura DateTime
  tomada_por        String?
  obrero_id         String?
  created_at        DateTime     @default(now())

  tarea             Tarea        @relation(fields: [tarea_id], references: [id], onDelete: Cascade)
  usuario           Usuario?     @relation(fields: [tomada_por], references: [id])
  obrero            Obrero?      @relation(fields: [obrero_id], references: [id])

  @@index([tarea_id])
  @@map("evidencias")
}

// ─── APROBACIONES ────────────────────────────────────────────────────────────

model Aprobacion {
  id                     String          @id @default(cuid())
  tarea_id               String
  aprobador_id           String
  estado                 EstadoAprobacion
  items_no_aprobados     Json?
  justificacion_por_item Json?
  fecha                  DateTime        @default(now())

  tarea                  Tarea           @relation(fields: [tarea_id], references: [id], onDelete: Cascade)
  aprobador              Usuario         @relation(fields: [aprobador_id], references: [id])

  @@index([tarea_id])
  @@map("aprobaciones")
}

// ─── REASIGNACIONES ─────────────────────────────────────────────────────────

model ReasignacionTarea {
  id                  String   @id @default(cuid())
  tarea_id            String
  proyecto_id         String
  contratista_anterior_id String?
  contratista_nuevo_id    String?
  realizado_por       String
  motivo              String?
  created_at          DateTime @default(now())

  tarea               Tarea    @relation(fields: [tarea_id], references: [id], onDelete: Cascade)
  proyecto            Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  contratista_anterior Usuario? @relation("ReasignacionAnterior", fields: [contratista_anterior_id], references: [id])
  contratista_nuevo   Usuario? @relation("ReasignacionNuevo", fields: [contratista_nuevo_id], references: [id])
  realizado           Usuario  @relation("ReasignacionRealizada", fields: [realizado_por], references: [id])

  @@index([tarea_id])
  @@index([proyecto_id])
  @@map("reasignaciones_tarea")
}

// ─── CHECKLISTS ──────────────────────────────────────────────────────────────

model ChecklistTemplate {
  id                String   @id @default(cuid())
  proyecto_id       String
  nombre_tarea_patron String
  items             Json
  created_at        DateTime @default(now())

  proyecto          Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@map("checklist_templates")
}

model ChecklistRespuesta {
  id               String   @id @default(cuid())
  tarea_id         String   @unique
  items_completados Json
  notas            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tarea            Tarea    @relation(fields: [tarea_id], references: [id], onDelete: Cascade)

  @@map("checklist_respuestas")
}

// ─── RETRASOS Y EXTENSIONES ──────────────────────────────────────────────────

model Retraso {
  id            String       @id @default(cuid())
  tarea_id      String
  tipo          TipoRetraso
  justificacion String
  evidencia_urls Json?
  created_at    DateTime     @default(now())

  tarea         Tarea        @relation(fields: [tarea_id], references: [id], onDelete: Cascade)

  @@map("retrasos")
}

model ExtensionTiempo {
  id                String   @id @default(cuid())
  tarea_id          String
  dias_adicionales  Int
  justificacion     String
  documentacion_url String
  autorizado_por    String
  fecha             DateTime @default(now())

  tarea             Tarea    @relation(fields: [tarea_id], references: [id], onDelete: Cascade)
  autorizador       Usuario  @relation(fields: [autorizado_por], references: [id])

  @@map("extensiones_tiempo")
}

model ConsumoMaterial {
  id              String   @id @default(cuid())
  tarea_id        String   @unique
  cantidad_real   Float
  piezas_danadas  Int      @default(0)
  notas_dano      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tarea           Tarea    @relation(fields: [tarea_id], references: [id], onDelete: Cascade)

  @@map("consumo_materiales")
}

// ─── GASTOS Y MATERIALES (B2C) ───────────────────────────────────────────────

enum EstadoGasto {
  REGISTRADO // lo registró el obrero, espera aprobación
  APROBADO   // el dueño lo aprobó
  RECHAZADO
}

model Gasto {
  id              String      @id @default(cuid())
  proyecto_id     String
  espacio_id      String?     // a qué espacio aplica (opcional)
  tarea_id        String?     // a qué tarea aplica (opcional)
  descripcion     String      // "Cerámica cocina"
  monto           Int         // COP (total del gasto)
  factura_url     String?     // foto de la factura (storage)
  estado          EstadoGasto @default(REGISTRADO)
  registrado_por  String
  aprobado_por    String?
  fecha           DateTime    @default(now())
  // Nivel detallado (opcional, para el "profi"):
  material        String?     // "Cemento gris 50kg"
  cantidad        Float?
  unidad          String?     // "saco", "m²", "bulto"
  precio_unitario Int?
  created_at      DateTime    @default(now())

  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  espacio     Espacio? @relation(fields: [espacio_id], references: [id], onDelete: SetNull)
  tarea       Tarea?   @relation(fields: [tarea_id], references: [id], onDelete: SetNull)
  registrador Usuario  @relation("GastosRegistrados", fields: [registrado_por], references: [id])
  aprobador   Usuario? @relation("GastosAprobados", fields: [aprobado_por], references: [id])

  @@index([proyecto_id])
  @@index([estado])
  @@map("gastos")
}

model Anticipo {
  id             String   @id @default(cuid())
  proyecto_id    String
  monto          Int      // COP entregado
  entregado_a    String?  // usuario (obrero/maestro) que recibió, opcional
  nota           String?
  fecha          DateTime @default(now())
  registrado_por String
  created_at     DateTime @default(now())

  proyecto    Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  receptor    Usuario? @relation("AnticiposRecibidos", fields: [entregado_a], references: [id])
  registrador Usuario  @relation("AnticiposRegistrados", fields: [registrado_por], references: [id])

  @@index([proyecto_id])
  @@map("anticipos")
}

// ─── AUDIT LOG ──────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  proyecto_id    String
  usuario_id     String
  accion         String   // e.g. "EDITAR_PROYECTO", "EDITAR_EDIFICIO"
  campo          String   // field that changed
  valor_anterior String?  // previous value (JSON string)
  valor_nuevo    String?  // new value (JSON string)
  created_at     DateTime @default(now())

  proyecto       Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [usuario_id], references: [id])

  @@map("audit_logs")
}

// ─── USUARIOS Y CONTRATISTAS ─────────────────────────────────────────────────

model Usuario {
  id              String      @id @default(cuid())
  email           String      @unique
  nombre          String
  telefono        String?
  avatar_url      String?
  constructora_id String
  rol_id          String
  invitado        Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  constructora           Constructora      @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  rol_ref                Rol               @relation(fields: [rol_id], references: [id])
  tareas_asignadas       Tarea[]           @relation("TareasAsignadas")
  evidencias_tomadas     Evidencia[]
  aprobaciones           Aprobacion[]
  extensiones_autorizo   ExtensionTiempo[]
  contratista_perfil     Contratista?
  obreros_a_cargo        Obrero[]          @relation("ObrerosDelContratista")
  sugerencias_hechas     TareaSugerida[]   @relation("SugerenciasContratista")
  sugerencias_revisadas  TareaSugerida[]   @relation("SugerenciasRevisadas")
  notificaciones         Notificacion[]
  audit_logs             AuditLog[]
  consentimientos        ConsentimientoDatos[]
  proyectos_administrados  AdminProyectoAccess[] @relation("AdminProyectoAccessUsuario")
  proyectos_asignados_por  AdminProyectoAccess[] @relation("AdminProyectoAccessAsignador")
  proyectos_como_contratista Proyecto[]            @relation("ContratistaDefaultProyectos")
  reasignaciones_anterior    ReasignacionTarea[]   @relation("ReasignacionAnterior")
  reasignaciones_nuevo       ReasignacionTarea[]   @relation("ReasignacionNuevo")
  reasignaciones_realizadas  ReasignacionTarea[]   @relation("ReasignacionRealizada")
  pwa_eventos                PwaEvento[]
  gastos_registrados         Gasto[]               @relation("GastosRegistrados")
  gastos_aprobados           Gasto[]               @relation("GastosAprobados")
  anticipos_recibidos        Anticipo[]            @relation("AnticiposRecibidos")
  anticipos_registrados      Anticipo[]            @relation("AnticiposRegistrados")

  @@map("usuarios")
}

model Contratista {
  id                       String   @id @default(cuid())
  usuario_id               String   @unique
  score_cumplimiento       Float    @default(0)
  score_calidad            Float    @default(0)
  score_velocidad_correccion Float  @default(0)
  score_total              Float    @default(0)
  historial_scores         Json     @default("[]")
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  usuario                  Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  pagos                    PagoContratista[]

  @@map("contratistas")
}

model PagoContratista {
  id                    String       @id @default(cuid())
  contratista_id        String
  proyecto_id           String
  periodo_inicio        DateTime
  periodo_fin           DateTime
  monto                 Float
  retegarantia_porcentaje Float      @default(5)
  monto_retenido        Float        @default(0)
  estado                EstadoPago   @default(PENDIENTE)
  visible_para_contratista Boolean   @default(false)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  contratista           Contratista  @relation(fields: [contratista_id], references: [id], onDelete: Cascade)
  proyecto              Proyecto     @relation(fields: [proyecto_id], references: [id])

  @@map("pagos_contratistas")
}

// ─── ROLES Y ACCESO ─────────────────────────────────────────────────────────

enum NivelAcceso {
  SUPER_ADMIN
  DIRECTIVO
  ADMIN_GENERAL
  ADMIN_PROYECTO
  CONTRATISTA
  OBRERO
}

model Rol {
  id              String       @id @default(cuid())
  constructora_id String
  nombre          String
  nivel_acceso    NivelAcceso
  es_default      Boolean      @default(false)
  created_at      DateTime     @default(now())

  constructora    Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  usuarios        Usuario[]

  @@unique([constructora_id, nombre])
  @@map("roles")
}

// ─── OBREROS ────────────────────────────────────────────────────────────────

model Obrero {
  id               String       @id @default(cuid())
  nombre           String
  token            String       @unique @default(cuid())
  contratista_id   String
  constructora_id  String
  fecha_inicio     DateTime
  fecha_expiracion DateTime
  activo           Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  // Información básica obligatoria al crear (legacy permite null para no romper)
  cedula                       String?
  telefono                     String?
  especialidad                 EspecialidadObrero?
  eps                          String?
  arl                          String?

  // Información adicional opcional
  fecha_nacimiento             DateTime?
  direccion                    String?
  contacto_emergencia          String?
  contacto_emergencia_telefono String?
  tipo_sangre                  String?
  anos_experiencia             Int?
  foto_url                     String?

  // Scoring — el sistema lo actualiza automáticamente
  score_total                  Float    @default(0)
  score_calidad                Float    @default(0)
  score_velocidad              Float    @default(0)
  score_cumplimiento           Float    @default(0)
  evidencias_aprobadas         Int      @default(0)
  evidencias_rechazadas        Int      @default(0)
  tareas_completadas           Int      @default(0)
  historial_scores             Json     @default("[]")

  contratista      Usuario      @relation("ObrerosDelContratista", fields: [contratista_id], references: [id])
  constructora     Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)
  evidencias       Evidencia[]

  @@unique([constructora_id, cedula])
  @@map("obreros")
}

