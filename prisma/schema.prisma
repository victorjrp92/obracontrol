// ─── CONSENTIMIENTO DE TRATAMIENTO DE DATOS ──────────────────────────────────
// Registro legal (Ley 1581 de 2012 — Habeas Data) de la autorización del titular.
// Se guarda versión del documento aceptado, IP, user-agent y fecha para prueba.
model ConsentimientoDatos {
  id          String   @id @default(cuid())
  usuario_id  String
  version     String   // versión de la política aceptada (ver POLITICA_VERSION)
  documento   String   // qué se aceptó, ej: "privacidad+terminos"
  ip          String?
  user_agent  String?
  aceptado_en DateTime @default(now())

  usuario     Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id])
  @@index([usuario_id, version])
  @@map("consentimientos_datos")
}

