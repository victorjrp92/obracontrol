// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum PlanTipo {
  PERSONAL
  OBRA
  PROYECTO
  EMPRESA
}

enum EstadoSuscripcion {
  PRUEBA // periodo de prueba, con fecha de fin
  ACTIVA // pagada y vigente
  VENCIDA // se acabó el periodo y no renovó
  CANCELADA // el cliente pidió cancelar; vale hasta que venza
}

/** Estado de un cobro de SUSCRIPCIÓN. No confundir con `EstadoPago`, que es el
 *  de los pagos a contratistas (PENDIENTE/PAGADO/PARCIAL) y no tiene relación. */
enum EstadoPagoSuscripcion {
  PENDIENTE // creado, esperando que Wompi confirme por webhook
  APROBADO
  RECHAZADO
  ANULADO
  ERROR
}

/**
 * Un intento de pago de suscripción. Se crea ANTES de mandar a la persona a
 * Wompi (en estado PENDIENTE) y se cierra cuando llega el webhook.
 *
 * Existe como tabla propia —y no como campos sueltos en Constructora— por tres
 * razones: hace falta un historial para facturar y para soporte; `referencia`
 * debe ser única para que el webhook sea idempotente (Wompi puede reintentarlo);
 * y guardar `cubre_desde`/`cubre_hasta` deja por escrito qué período pagó cada
 * transacción, que es lo que se discute cuando alguien reclama.
 */
model PagoSuscripcion {
  id                   String     @id @default(cuid())
  constructora_id      String
  /** La referencia que viaja a Wompi. Única: es la llave de idempotencia del webhook. */
  referencia           String     @unique
  /** ID de la transacción en Wompi. Llega con el webhook. */
  wompi_transaccion_id String?    @unique
  plan                 PlanTipo
  periodo_meses        Int        @default(1)
  /** En centavos, como lo exige Wompi. Evita cualquier redondeo de punto flotante. */
  monto_centavos       Int
  moneda               String     @default("COP")
  /** CARD | PSE | NEQUI | BANCOLOMBIA_TRANSFER — lo reporta Wompi. */
  metodo               String?
  estado               EstadoPagoSuscripcion @default(PENDIENTE)
  cubre_desde          DateTime?
  cubre_hasta          DateTime?
  created_at           DateTime   @default(now())
  updated_at           DateTime   @updatedAt

  constructora Constructora @relation(fields: [constructora_id], references: [id], onDelete: Cascade)

  @@index([constructora_id, created_at])
  @@index([estado])
  @@map("pagos_suscripcion")
}

// Tipo de cuenta: perfil con el que se usa la app.
//   CONSTRUCTORA → empresa (flujo completo actual).
//   CONTRATISTA  → contratista B2C: emprendedor de oficio; envía a su personal a
//                  ejecutar trabajos en obras de sus clientes. Maneja varias
//                  obras/clientes. (Antes ARQUITECTO.)
//   PROPIETARIO  → persona natural: maneja su propia obra y contrata obreros directos.
enum TipoCuenta {
  CONSTRUCTORA
  CONTRATISTA
  PROPIETARIO
  /// Profesional que emite productos técnicos (planos, renders, actas firmadas).
  /// La interfaz lo llama «Arquitecto»; el valor abarca también a proyectistas
  /// e ingenieros que hacen el mismo trabajo.
  ARQUITECTO
}

enum SubtipoProyecto {
  CASAS
  APARTAMENTOS
  ZONAS_COMUNES
}

enum EstadoProyecto {
  /// Trato aún no cerrado: existe para cotizar. Lleva el levantamiento
  /// fotográfico y la cotización, pero NO cuenta como obra activa —el cobro
  /// mira `ACTIVO`, así que cotizar no consume cupo del plan—. Pasa a `ACTIVO`
  /// cuando el cliente firma la cotización.
  PREPROYECTO
  ACTIVO
  PAUSADO
  COMPLETADO
  ARCHIVADO
}

