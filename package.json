{
  "name": "obracontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "docker:dev": "docker compose up --build",
    "docker:build": "docker build -t obracontrol .",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-test-users": "npx tsx scripts/seed-test-users.ts",
    "db:seed-personal": "npx tsx scripts/seed-personal-users.ts",
    "db:seed-roles": "npx tsx scripts/seed-roles-test.ts",
    "db:backfill-numeros": "npx tsx scripts/backfill-numero-registro.ts",
    "db:demo-clean": "npx tsx scripts/demo-clean.ts",
    "db:demo-seed": "npx tsx scripts/seed-demo-content.ts",
    "db:seed-camara": "npx tsx scripts/seed-demo-camara.ts",
    "verify:alerta": "npx tsx scripts/verificar-reglas-alerta.ts && npx tsx scripts/verificar-triage-alerta.ts",
    "seguridad:probar": "npx tsx scripts/pentest.ts",
    "seguridad:rotar-tokens": "npx tsx scripts/rotar-tokens-obrero.ts",
    "db:migrate-deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.6.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.104.1",
    "@types/pg": "^8.21.0",
    "@vercel/analytics": "^2.0.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "serwist": "^9.5.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
